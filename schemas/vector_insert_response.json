{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["success", "id"],
  "properties": {
    "success": { 
      "type": "boolean", 
      "description": "Whether the insertion was successful"
    },
    "id": { 
      "type": "integer", 
      "description": "The ID of the inserted vector"
    },
    "task_id": { 
      "type": ["integer", "null"], 
      "description": "The task ID associated with the vector, if any"
    }
  }
}