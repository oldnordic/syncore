{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "function_name": {
      "type": "string"
    },
    "direct_callers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "indirect_callers": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "total_impact_count": {
      "type": "integer"
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    }
  },
  "required": ["function_name", "direct_callers", "total_impact_count", "risk_level"]
}
