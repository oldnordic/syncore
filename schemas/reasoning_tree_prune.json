{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reasoning Tree Prune",
  "description": "Prune a subtree from reasoning tree",
  "type": "object",
  "required": ["session_id", "node_id"],
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID of reasoning session",
      "minLength": 1,
      "maxLength": 100
    },
    "node_id": {
      "type": "string",
      "description": "ID of node to prune (removes subtree)",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "additionalProperties": false
}