{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Memory Suite",
  "description": "Arguments for memory suite operations",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "Command to execute"
    },
    "key": {
      "type": "string",
      "description": "Memory key"
    },
    "value": {
      "type": "string",
      "description": "Memory value"
    },
    "text": {
      "type": "string",
      "description": "Text for vector operations"
    },
    "query": {
      "type": "string",
      "description": "Query for search operations"
    },
    "limit": {
      "type": "integer",
      "description": "Result limit"
    },
    "namespace": {
      "type": "string",
      "description": "Namespace for operations"
    },
    "goal": {
      "type": "string",
      "description": "Task goal"
    },
    "priority": {
      "type": "integer",
      "description": "Task priority"
    },
    "dry_run": {
      "type": "boolean",
      "description": "Dry run mode"
    }
  },
  "required": ["command"]
}