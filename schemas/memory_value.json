{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "value": {
      "type": ["string", "null"],
      "description": "The stored value or null if not found"
    },
    "found": {
      "type": "boolean",
      "description": "Whether the key was found"
    }
  },
  "required": ["value", "found"]
}