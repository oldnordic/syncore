{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": { 
      "type": "string", 
      "minLength": 1,
      "description": "The search query"
    },
    "k": { 
      "type": "integer", 
      "minimum": 1, 
      "maximum": 64, 
      "default": 8,
      "description": "Maximum number of results to return"
    },
    "scope": {
      "oneOf": [
        { "const": "global" },
        { "type": "object", "required": ["task_id"], "properties": { "task_id": { "type": "integer", "minimum": 0 } } }
      ],
      "default": "global",
      "description": "Search scope filter"
    }
  },
  "additionalProperties": false
}