{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Mapping Suite",
  "description": "Arguments for mapping suite operations",
  "type": "object",
  "properties": {
    "command": {
      "type": "string",
      "description": "Command to execute",
      "enum": [
        "record",
        "get",
        "search",
        "deps",
        "app_record",
        "app_get",
        "app_history",
        "app_search",
        "help"
      ]
    },
    "path": {
      "type": "string",
      "description": "File or directory path"
    },
    "kind": {
      "type": "string",
      "description": "Node type (file, directory, module)",
      "default": "file"
    },
    "language": {
      "type": "string",
      "description": "Programming language for the node"
    },
    "imports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of imports"
    },
    "exports": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of exports"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of dependencies"
    },
    "query": {
      "type": "string",
      "description": "Search query"
    },
    "file_path": {
      "type": "string",
      "description": "File path for application change tracking"
    },
    "change_type": {
      "type": "string",
      "description": "Type of change (create, modify, delete)"
    },
    "old_content": {
      "type": "string",
      "description": "Previous content for change tracking"
    },
    "new_content": {
      "type": "string",
      "description": "New content for change tracking"
    },
    "line_start": {
      "type": "integer",
      "description": "Starting line number of change",
      "minimum": 1
    },
    "line_end": {
      "type": "integer",
      "description": "Ending line number of change",
      "minimum": 1
    },
    "description": {
      "type": "string",
      "description": "Description of the change"
    },
    "task_id": {
      "type": "integer",
      "description": "Task ID for change tracking",
      "minimum": 1
    }
  },
  "required": ["command"]
}